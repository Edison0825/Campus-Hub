@startuml campus-hub-use-case
left to right direction
skinparam actorStyle awesome

actor "Student" as Student
actor "Teacher" as Teacher
actor "Admin" as Admin
actor "Guest" as Guest

rectangle "Campus Hub" {
  usecase "Register / Login" as UC_Auth
  usecase "Browse Courses" as UC_Browse
  usecase "Enroll Course" as UC_Enroll
  usecase "View Course Materials" as UC_ViewMaterials
  usecase "Upload Resources" as UC_Upload
  usecase "Submit Assignment" as UC_Submit
  usecase "Grade Assignment" as UC_Grade
  usecase "View Grades" as UC_ViewGrades
  usecase "Post Announcement" as UC_Announce
  usecase "Create Event" as UC_CreateEvent
  usecase "Join Event" as UC_JoinEvent
  usecase "Message / Chat" as UC_Message
  usecase "Search" as UC_Search
  usecase "Report Issue" as UC_Report
  usecase "Manage Users / Roles" as UC_ManageUsers
}

Guest --> UC_Browse
Guest --> UC_Search
Guest --> UC_Auth

Student --> UC_Auth
Student --> UC_Browse
Student --> UC_Enroll
Student --> UC_ViewMaterials
Student --> UC_Submit
Student --> UC_ViewGrades
Student --> UC_JoinEvent
Student --> UC_Message
Student --> UC_Search
Student --> UC_Report

Teacher --> UC_Auth
Teacher --> UC_Browse
Teacher --> UC_ViewMaterials
Teacher --> UC_Upload
Teacher --> UC_Grade
Teacher --> UC_Announce
Teacher --> UC_CreateEvent
Teacher --> UC_Message
Teacher --> UC_Search

Admin --> UC_Auth
Admin --> UC_ManageUsers
Admin --> UC_Announce
Admin --> UC_CreateEvent
Admin --> UC_Browse
Admin --> UC_Search
Admin --> UC_Report

UC_Enroll .> UC_Auth : <<include>>
UC_Submit .> UC_Auth : <<include>>
UC_Upload .> UC_Auth : <<include>>
UC_ManageUsers .> UC_Auth : <<include>>
UC_Grade .> UC_Auth : <<include>>

note right of UC_ManageUsers
  管理员可以添加/删除/修改用户及角色
end note

@enduml